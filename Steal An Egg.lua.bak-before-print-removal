        -- dari script dump doang. Kalau ada area yang nest-nya != 5, slot itu ke-skip.
        local PREDICT_SLOTS = { "Slot_001", "Slot_002", "Slot_003", "Slot_004", "Slot_005" }
        local MAX_PREDICT_PERIODS_AHEAD = 2016 -- 2016 x 300 detik = 7 hari ke depan

        local function simulatePeriodEggs(periodIndex)
            local eggs = {}
            for _, areaName in ipairs(PREDICT_AREAS) do
                for _, slotName in ipairs(PREDICT_SLOTS) do
                    local egg = simulateSlotEgg(periodIndex, areaName, slotName, PredictAreas, PredictAssets, PredictLotteryCustom, AreaEggResetTimeUtil)
                    if egg then table.insert(eggs, egg) end
                end
            end
            return eggs
        end

        -- Scan maju period demi period nyari kemunculan PERTAMA rarity target, di area/
        -- slot manapun. Di-yield tiap 50 period biar gak nge-freeze game pas scan jauh.
        local function findNextRarityAppearance(rarityId, startPeriod)
            for i = 1, MAX_PREDICT_PERIODS_AHEAD do
                if i % 50 == 0 then task.wait() end
                local period = startPeriod + i
                for _, areaName in ipairs(PREDICT_AREAS) do
                    for _, slotName in ipairs(PREDICT_SLOTS) do
                        local egg = simulateSlotEgg(period, areaName, slotName, PredictAreas, PredictAssets, PredictLotteryCustom, AreaEggResetTimeUtil)
                        if egg and egg.rarity == rarityId then
                            return {
                                periodsAhead = i,
                                periodIndex = period,
                                releaseAt = AreaEggResetTimeUtil.GetPeriodStartsAt(period),
                                area = areaName,
                                slot = slotName,
                                petName = egg.petName
                            }
                        end
                    end
                end
            end
            return nil
        end

        local cachedPeriod = -1
        local cachedTargetRarity = nil
        local cachedNightPreviewStr = ""
        -- Data MENTAH hasil scan (petName/area/releaseAt), BUKAN teks "dlm X" yang udah
        -- jadi -- soalnya kalau teksnya di-cache duluan, ETA-nya kebekukan sampai period
        -- berikutnya (5 menit) dan gak keliatan ngitung turun tiap detik kayak yang
        -- dilaporkan. false = "None" dipilih, nil = udah discan tapi gak ketemu.
        local cachedTargetFound = false

        while Config.EggPredictUI do
            -- Dibungkus pcall -- sebelumnya satu error di tengah loop (misal nulis
            -- property ke Instance yang ternyata kena batasan capability) bikin SELURUH
            -- coroutine mati diam-diam, macet permanen di teks "Fetching..." tanpa ada
            -- tanda apa pun kenapa. Sekarang errornya ke-log dan loop tetep lanjut coba lagi.
            local tickOk, tickErr = pcall(function()
            local now = Workspace:GetServerTimeNow()
            local currentPeriod = AreaEggResetTimeUtil.GetPeriodIndex(now)
            local nextResetAt = AreaEggResetTimeUtil.GetNextResetAt(now)
            local timeUntilReset = math.max(0, nextResetAt - now)

            if currentPeriod ~= cachedPeriod or Config.EggPredictTargetRarity ~= cachedTargetRarity then
                cachedPeriod = currentPeriod
                cachedTargetRarity = Config.EggPredictTargetRarity

                -- Reset berikutnya ("next night"): filter RarityNumber 7 (Cosmic) s/d 10
                -- (Divine/Superior) -- range murni angka, jadi ANGGOTA ganda kayak Exotic
                -- (sama-sama 8 kayak Secret) atau Limited (sama-sama 9 kayak Eternal) ikut
                -- kebawa, itu memang sesuai permintaan "range Cosmic sampai Divine".
                local nextEggs = simulatePeriodEggs(currentPeriod + 1)
                local rareEggs = {}
                for _, egg in ipairs(nextEggs) do
                    if egg.rarityNumber >= 7 and egg.rarityNumber <= 10 then
                        table.insert(rareEggs, egg)
                    end
                end
                table.sort(rareEggs, function(a, b) return a.rarityNumber > b.rarityNumber end)

                if #rareEggs == 0 then
                    cachedNightPreviewStr = "<font color='rgb(120,120,120)'><i>Gak ada egg Cosmic~Divine di reset berikutnya.</i></font>"
                else
                    local lines = {}
                    for _, egg in ipairs(rareEggs) do
                        table.insert(lines, string.format(
                            "<font color='rgb(160,148,255)'>\226\128\162 [%s] %s</font> <font color='rgb(150,150,150)'>- %s</font>",
                            egg.rarity, egg.petName, egg.area
                        ))
                    end
                    cachedNightPreviewStr = table.concat(lines, "\n")
                end

                -- Target tracker: match nama rarity PERSIS (bukan RarityNumber >= X --
                -- itu bug lama, Exotic/Limited numpang lolos gara-gara angkanya ketuker
                -- sama Secret/Eternal), jadi hasilnya gak bisa salah pilih rarity. Slot
                -- gak ditampilin -- cuma bikin panjang, gak kepake user. Cuma scan-nya
                -- (mahal) yang di-cache di sini -- teks ETA-nya dibangun ulang di bawah.
                if cachedTargetRarity and cachedTargetRarity ~= "None" then
                    cachedTargetFound = findNextRarityAppearance(cachedTargetRarity, currentPeriod)
                else
                    cachedTargetFound = false
                end
            end

            -- Teks Target Tracker dibangun ULANG tiap tick (bukan di dalem blok cache
            -- di atas), pakai `now` yang fresh -- ini yang bikin "dlm X" beneran ngitung
            -- turun tiap detik, bukan kebekukan sampai period berikutnya.
            local targetStr
            if not cachedTargetRarity or cachedTargetRarity == "None" then
                targetStr = "<font color='rgb(150,150,150)'><i>Pilih rarity dulu di dropdown.</i></font>"
            elseif cachedTargetFound then
                local eta = math.max(0, cachedTargetFound.releaseAt - now)
                targetStr = string.format(
                    "<font color='rgb(0,255,150)'><b>%s</b></font>\n<font color='rgb(220,220,220)'>%s di %s, dlm %s</font>",
                    cachedTargetRarity, cachedTargetFound.petName, cachedTargetFound.area, formatPredictDuration(eta)
                )
            else
                targetStr = string.format(
                    "<font color='rgb(255,255,255)'><b>%s</b></font>\n<font color='rgb(150,150,150)'><i>Gak ketemu dalam 7 hari ke depan.</i></font>",
                    cachedTargetRarity
                )
            end

            if EggPredictTextLabel then
                local displayStr = string.format(
                    "<font color='rgb(160,148,255)'><b>NEXT RESET IN %s</b></font>\n\n",
                    formatPredictDuration(timeUntilReset)
                )
                displayStr = displayStr .. "<font color='rgb(160,148,255)'><b>\240\159\140\153 NEXT RESET - RARE EGGS:</b></font>\n"
                displayStr = displayStr .. cachedNightPreviewStr .. "\n\n"
                displayStr = displayStr .. "<font color='rgb(160,148,255)'><b>\240\159\142\175 TARGET TRACKER:</b></font>\n"
                displayStr = displayStr .. targetStr
                EggPredictTextLabel.Text = displayStr
            end
            end)

            if not tickOk then
                warn("[EggPredictor] Error di tick loop:", tickErr)
                if EggPredictTextLabel then
                    EggPredictTextLabel.Text = "<font color='rgb(255,80,80)'>Error: " .. tostring(tickErr) .. "</font>"
                end
            end

            task.wait(1)
        end
        eggPredictActive = false
        toggleEggPredictUI(false)
    end)
end

