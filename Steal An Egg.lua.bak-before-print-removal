-- Baca source file kita sendiri (bukan lewat URL/hub -- langsung dari file lokal
-- yang lagi dieksekusi), buat dititipkan ke queue_on_teleport atau disalin ke autoexec.
local AUTOEXEC_BACKUP_PATH = "autoexec/Steal An Egg.lua"

local function getOwnScriptSource()
    if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
        return nil, "readfile/isfile gak ada di executor ini"
    end

    -- Metode utama: debug.getinfo(1, "S").source = chunk name script yang lagi jalan,
    -- biasanya "@<path file>". Ini CUMA valid kalau script-nya dijalanin langsung dari
    -- file lokal -- kalau di-loadstring dari HttpGet/hub, source-nya BUKAN path asli,
    -- jadi isfile() bakal gagal di sini.
    local ok, info = pcall(debug.getinfo, 1, "S")
    local src = ok and info and info.source or ""
    local path = src:gsub("^@", "")

    if path ~= "" and isfile(path) then
        local content = readfile(path)
        if content and #content >= 1000 then
            return content
        end
    end

    -- Fallback: kalau metode utama gagal (path bukan file asli/kependekan), coba baca
    -- balik backup yang udah ditulis selfInstallAutoExec() di sesi SEBELUMNYA (kalau
    -- ada). Bisa aja agak ketinggalan versi kalau script-nya baru diubah, tapi jauh
    -- lebih baik daripada gak ada apa-apa buat dititipkan ke queue_on_teleport.
    if isfile(AUTOEXEC_BACKUP_PATH) then
        local backupContent = readfile(AUTOEXEC_BACKUP_PATH)
        if backupContent and #backupContent >= 1000 then
            return backupContent
        end
    end

    return nil, "Gak nemu source sendiri lewat path: '" .. tostring(path) .. "' (executor mungkin gak expose path asli), dan gak ada backup autoexec juga"
end

-- Log ke FILE (bukan cuma console) tiap kali queueSelfForTeleport dipanggil -- karena
-- pemicu utamanya (Anti AFK abis 18 menit idle) kejadian pas user LAGI GAK DI DEPAN
-- LAYAR, jadi gak ada yang bisa liat warn() di console pas itu kejadian. Kalau nanti
-- masih gagal auto-lanjut, tinggal cek isi file ini abis balik.
local ANTIAFK_LOG_PATH = "Napoleon_AntiAFK_Log.txt"
local ANTIAFK_LOG_MAX_LINES = 50

local function logSelfTeleportAttempt(message)
    pcall(function()
        if typeof(writefile) ~= "function" then return end

        -- APPEND (bukan overwrite kayak sebelumnya) -- biar histori kejadiannya kesimpen
        -- semua, gak cuma pesan paling terakhir. Dibatasi ANTIAFK_LOG_MAX_LINES baris
        -- biar gak membengkak kalau dibiarin farming lama.
        local existing = ""
        if typeof(readfile) == "function" and typeof(isfile) == "function" and isfile(ANTIAFK_LOG_PATH) then
            existing = readfile(ANTIAFK_LOG_PATH) or ""
        end

        local lines = {}
        for line in existing:gmatch("[^\r\n]+") do
            table.insert(lines, line)
        end
        table.insert(lines, "[" .. os.date("%Y-%m-%d %H:%M:%S") .. "] " .. message)

        while #lines > ANTIAFK_LOG_MAX_LINES do
            table.remove(lines, 1)
        end

        writefile(ANTIAFK_LOG_PATH, table.concat(lines, "\n"))
    end)
end

-- Titipkan script ini sendiri ke queue_on_teleport supaya begitu kita landing di
-- server/place baru abis teleport apa pun (dipakai Anti AFK buat auto-lanjut abis
-- rejoin idle), executor otomatis nge-run script ini lagi -- gak butuh host URL sama sekali.
local function queueSelfForTeleport()
    local queueFunc = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
    if not queueFunc then
        warn("[SelfPersist] Executor gak punya queue_on_teleport! Abis teleport, kamu perlu inject manual lagi.")
        logSelfTeleportAttempt("GAGAL: executor gak punya queue_on_teleport sama sekali.")
        return false
    end

    local ownSource, srcErr = getOwnScriptSource()
    if not ownSource then
        warn("[SelfPersist] Gagal ambil source sendiri buat dititipkan:", srcErr)
        logSelfTeleportAttempt("GAGAL ambil source: " .. tostring(srcErr))
        return false
    end

    local qok, qerr = pcall(queueFunc, ownSource)
    if qok then
        print("[SelfPersist] Script berhasil dititipkan lewat queue_on_teleport, bakal lanjut otomatis abis teleport.")
        logSelfTeleportAttempt("SUKSES dititipkan (" .. #ownSource .. " char).")
        return true
    else
        warn("[SelfPersist] queue_on_teleport gagal:", qerr)
        logSelfTeleportAttempt("GAGAL queue_on_teleport: " .. tostring(qerr))
        return false
    end
end

-- Best-effort tambahan: salin juga ke folder autoexec bawaan executor (kalau ada),
-- biar tetap auto-jalan pas kamu manual rejoin/restart Roblox di lain waktu, DAN
-- jadi fallback source buat getOwnScriptSource() di atas kalau metode utama gagal.
local function selfInstallAutoExec()
    local ok, resultOrErr = pcall(function()
        if typeof(writefile) ~= "function" or typeof(isfolder) ~= "function" or typeof(makefolder) ~= "function" then
            return "writefile/isfolder/makefolder gak ada di executor ini"
        end

        local content, srcErr = getOwnScriptSource()
        if not content then
            return srcErr
        end

        if not isfolder("autoexec") then
            makefolder("autoexec")
        end
        writefile(AUTOEXEC_BACKUP_PATH, content)
        return true
    end)

    if ok and resultOrErr == true then
        print("[SelfPersist] Berhasil install ke " .. AUTOEXEC_BACKUP_PATH .. " juga (jaga-jaga buat rejoin manual / fallback queue_on_teleport).")
        return true
    else
        warn("[SelfPersist] Gagal self-install ke autoexec (opsional, bukan fatal):", ok and resultOrErr or tostring(resultOrErr))
        return false
    end
end

